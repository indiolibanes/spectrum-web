{
  "name": "SPECTRUM-LAB PRO (supervis\u00f3rio NIR)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {},
  "forwardPorts": [
    6080
  ],
  "portsAttributes": {
    "6080": {
      "label": "\u00c1rea de trabalho (noVNC)",
      "visibility": "private",
      "onAutoForward": "notify"
    }
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash run/setup.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
